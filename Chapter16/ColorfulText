/*
 * Write a GUI application that contains a text, radio buttons, and right and left arrows.
 * The text should be displayed in the center of the pane. It should move right and left upon button clicks.
 * The radio buttons should be used to change the text color. The colors are red, yellow, black, orange, and green.
 * The text should not move outside the pane.
 * The buttons should be displayed at the bottom of the pane, and the radio buttons should be displayed at the top of the pane.
 * 
 * Author: Emily Rhodes
 * Date: 04/06/2026
 * Course: TESD 1800
 */

import javafx.geometry.Insets;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.RadioButton;
import javafx.scene.control.ToggleGroup;
import javafx.scene.layout.BorderPane;
import javafx.scene.layout.HBox;
import javafx.scene.paint.Color;
import javafx.scene.text.Text;
import javafx.stage.Stage;
import javafx.application.Application;

public class ColorfulText extends Application {
  private Text text = new Text("Programming is fun");

    // Create a pane to hold everything    
    protected BorderPane getPane() {
      // HBox for radio buttons
      HBox radioBox = new HBox(10);
      radioBox.setPadding(new Insets(10));
      
      // Create radio buttons for color selection
      RadioButton redButton = new RadioButton("Red");
      RadioButton yellowButton = new RadioButton("Yellow");
      RadioButton blackButton = new RadioButton("Black");
      RadioButton orangeButton = new RadioButton("Orange");
      RadioButton greenButton = new RadioButton("Green");

      // Group the radio buttons 
      ToggleGroup colorGroup = new ToggleGroup();
      redButton.setToggleGroup(colorGroup);
      yellowButton.setToggleGroup(colorGroup);
      blackButton.setToggleGroup(colorGroup);
      orangeButton.setToggleGroup(colorGroup);
      greenButton.setToggleGroup(colorGroup);

      blackButton.setSelected(true);

      // Set action for radio buttons to change text color
      redButton.setOnAction(e -> text.setFill(Color.RED));
      yellowButton.setOnAction(e -> text.setFill(Color.YELLOW));  
      blackButton.setOnAction(e -> text.setFill(Color.BLACK));
      orangeButton.setOnAction(e -> text.setFill(Color.ORANGE));
      greenButton.setOnAction(e -> text.setFill(Color.GREEN));

      // Add radio buttons to the HBox
      radioBox.getChildren().addAll(redButton, yellowButton, blackButton, orangeButton, greenButton);
      radioBox.setAlignment(javafx.geometry.Pos.CENTER);

      // Add the text to a pane and set its initial position
      javafx.scene.layout.Pane textPane = new javafx.scene.layout.Pane();
      textPane.getChildren().add(text);
      text.setY(75);

      // HBox for left and right arrow buttons
      HBox arrowBox = new HBox(10);
      Button leftArrow = new Button("<=");
      Button rightArrow = new Button("=>");

      // Set action for arrow buttons to move text left and right
      leftArrow.setOnAction(e -> {
          if (text.getX() > 0) {
              text.setX(text.getX() - 10);
          }
      });

      rightArrow.setOnAction(e -> {
          if (text.getX() < textPane.getWidth() - text.getLayoutBounds().getWidth()) {
              text.setX(text.getX() + 10);
         }
      });

      // Add radio buttons and arrow buttons to their respective HBoxes and align them
      arrowBox.getChildren().addAll(leftArrow, rightArrow);
      arrowBox.setAlignment(javafx.geometry.Pos.CENTER);

      // Create a BorderPane and add the HBoxes and text
      BorderPane pane = new BorderPane();
      pane.setTop(radioBox);
      pane.setBottom(arrowBox);
      pane.setCenter(textPane);

      return pane;
    }
    
    public void start(Stage primaryStage) {

        // Create a scene and place it in the stage
        Scene scene = new Scene(getPane(), 450, 200);
        primaryStage.setTitle("Exercise 16_01");
        primaryStage.setScene(scene);
        primaryStage.show();
    }

    public static void main(String[] args) {
        Application.launch(args);
    }
}
